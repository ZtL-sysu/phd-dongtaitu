  "method": {
    "stable_seed": "SHA256(colon-joined integer args), first 8 digest bytes little-endian",
    "rng": "numpy.default_rng(_stable_seed(base_seed,0))",
    "base_seed": "_stable_seed(recipe_seed, trajectory_index, metadata.seed)",
    "time_block": "block_len=max(1,round(T*rate)); start=rng.integers(0,T-block_len+1); block is [start,start+block_len)",
    "rate_zero": "visibility remains all true; no block draw",
    "origins": "PreparedData.origins(split): first=max(L-1,split_start-1), last=split_stop-H-1 inclusive",
    "history": "each origin input bins [origin-L+1,origin] inclusive; target arrays are not read"
  },
  "coverage_definitions": {
    "requested_fulltrajectory_rate": "requested rate used to round block length; realized rate is rounded block_length/T",
    "union_history_coverage_fraction": "fraction of unique bins in union of declared test-history windows overlapped by block",
    "replayed_history_coverage_fraction": "blocked time-bin positions counted across every declared origin history window divided by origin_count*L; one bin may count repeatedly",
    "zero_effect": "block does not intersect any declared test input history window"
  },
